# Neon → Dashboard → Connect → copy the connection string
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=your-gemini-api-key
# Set to false only if web search fails with "invalid peer certificate" behind a corporate proxy
WEB_SEARCH_VERIFY_SSL=true
