# ============================================================
# 大模型配置 (LLM Configuration)
# ============================================================
# 支持 OpenAI 兼容接口的模型服务商（DeepSeek / OpenAI / 通义千问 等）
MODEL_API_KEY=your-api-key-here
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# ============================================================
# Neo4j 图数据库配置
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# ============================================================
# Embedding 模型配置
# ============================================================
# 本地模型路径（可选，留空则自动从 HuggingFace 下载 BAAI/bge-large-zh-v1.5）
EMBEDDING_MODEL_PATH=

# ============================================================
# 即梦 AI 配置（火山引擎，用于小红书配图生成）
# ============================================================
JIMENG_AK=your-jimeng-access-key-here
JIMENG_SK=your-jimeng-secret-key-here
