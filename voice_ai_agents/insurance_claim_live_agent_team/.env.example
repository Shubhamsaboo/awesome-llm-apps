# Local ADK Web development with Google AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=replace-me

# Optional Gemini Live settings. Defaults are shown.
# FNOL_GEMINI_LIVE_MODEL=gemini-3.8-live
# FNOL_SKETCH_MODEL=gemini-3.1-flash-image
# FNOL_VOICE=Kore
# Optional comma-separated names or terms to help speech recognition.
# FNOL_TRANSCRIPTION_VOCABULARY=Example Name,Example Surname

# Optional Live Avatar. Uses Google Cloud ADC for the live connection only.
# Keep GOOGLE_API_KEY for the existing claim workflow and sketch generation.
# Run: gcloud auth application-default login
# FNOL_AVATAR_NAME=Kira
# FNOL_AVATAR_PROJECT=your-project-id
# FNOL_AVATAR_LOCATION=us-central1
# FNOL_AVATAR_VOICE=Kore
# Custom appearance requires Google Cloud allowlisting. Supply your own PNG
# under 5 MB, at least 704 x 1280 pixels. Overrides FNOL_AVATAR_NAME.
# FNOL_AVATAR_IMAGE=/path/to/your/avatar.png

# Optional Vertex AI settings for future Agent Platform work.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
