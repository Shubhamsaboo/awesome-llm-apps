# Copy to .env (adk web reads it) or export in your shell.

# Default path: a Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# ...or Vertex AI instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

ADK_MODEL=gemini-2.5-flash

# Policy thresholds (optional, these are the defaults)
# P06_AUTO_APPROVE_LIMIT=100
# P06_MIN_CONFIDENCE=0.8

# VAID credential settings (optional, these are the defaults)
# P06_VAID_TRUST_DOMAIN=hitl-approval.demo
# P06_VAID_TTL_HOURS=1
