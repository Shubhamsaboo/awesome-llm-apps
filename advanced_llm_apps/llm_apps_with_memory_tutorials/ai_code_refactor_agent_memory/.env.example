# Ollama Configuration
# Make sure Ollama is running: ollama serve (or set OLLAMA_HOST to use different port)
OLLAMA_HOST=http://localhost:11435
OLLAMA_MODEL=mistral

# Agent Settings
# Temperature: 0.0 = deterministic, 1.0 = creative (0.3 is good for refactoring)
OLLAMA_TEMPERATURE=0.3

# Memory Settings
# Path where Qdrant will store embeddings
QDRANT_PATH=./qdrant_storage

# Optional: If using Mem0 cloud (not required for local setup)
# MEM0_API_KEY=your_key_here
# MEM0_ORG_ID=your_org_id

# Streamlit Settings (optional)
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true
