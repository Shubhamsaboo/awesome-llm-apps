{
  "manifest_version": 3,
  "name": "ripple",
  "version": "0.0.1",
  "description": "See which sentences may need updating when you change a fact in your Google Doc.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "http://127.0.0.1:4212/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ripple",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/d/*/edit*"],
      "js": ["correction.js", "bootstrap.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/document/d/*/edit*"],
      "js": ["correction.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core.js", "ui.js", "logo.js"],
      "matches": ["https://docs.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
