{
  "manifest_version": 3,
  "name": "摘一句",
  "version": "0.1.0",
  "description": "手动记下喜欢的句子，保存在当前浏览器，随时复制或删除。",
  "permissions": ["storage"],
  "action": {
    "default_title": "摘一句",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
