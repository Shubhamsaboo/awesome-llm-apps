# Copy this file to .env and fill in your key (optional).
# The .env file is git-ignored and must never be committed.
#
# Without a key: the demo runs the full PQC flow
# (keygen -> sign -> local verify) and skips the LLM step.
#
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
